{
  "name": "@ienlab/react-library",
  "version": "0.17.0-beta.51",
  "description": "My React component library",
  "main": "./dist/my-library.cjs.js",
  "module": "./dist/my-library.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/my-library.es.js",
      "require": "./dist/my-library.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./og": {
      "import": "./dist/og/index.js",
      "types": "./dist/og/index.d.ts"
    }
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:og",
    "build:og": "tsc -p tsconfig.node-out.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "@tanstack/react-table": ">=8.21.3",
    "browser-image-compression": ">=2.0.2",
    "dayjs": "^1.11.0",
    "firebase": ">=12.0.0",
    "i18next": ">=23.0.0",
    "motion": ">=12.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-i18next": ">=16.0.0",
    "react-router": ">=7.0.0",
    "zustand": ">=5.0.0",
    "react-helmet-async": ">=3.0.0"
  },
  "devDependencies": {
    "browser-image-compression": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dayjs": "^1.11.21",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase": "^12.14.0",
    "globals": "^17.6.0",
    "i18next": "^26.3.1",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^7.17.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "zustand": "^5.0.14",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "react-helmet-async": "^3.0.0"
  }
}
